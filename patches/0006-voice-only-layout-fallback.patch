diff --git a/lib/features/voice/utils/voice_visual_fallback.dart b/lib/features/voice/utils/voice_visual_fallback.dart
new file mode 100644
--- /dev/null
+++ b/lib/features/voice/utils/voice_visual_fallback.dart
@@ -0,0 +1,8 @@
+// When no camera or screen share is active, show voice avatars even if the
+// user previously selected the "Only show videos" filter.
+bool voiceGridNeedsAudioOnlyFallback({
+  required bool onlyShowVideos,
+  required bool hasActiveVisual,
+}) {
+  return onlyShowVideos && !hasActiveVisual;
+}
diff --git a/test/features/voice/utils/voice_visual_fallback_test.dart b/test/features/voice/utils/voice_visual_fallback_test.dart
new file mode 100644
--- /dev/null
+++ b/test/features/voice/utils/voice_visual_fallback_test.dart
@@ -0,0 +1,36 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:fluxer_app/features/voice/utils/voice_visual_fallback.dart';
+
+void main() {
+  group('voiceGridNeedsAudioOnlyFallback', () {
+    test('restores voice avatars when the last video stops', () {
+      expect(
+        voiceGridNeedsAudioOnlyFallback(
+          onlyShowVideos: true,
+          hasActiveVisual: false,
+        ),
+        isTrue,
+      );
+    });
+
+    test('keeps video filtering if screen share remains active', () {
+      expect(
+        voiceGridNeedsAudioOnlyFallback(
+          onlyShowVideos: true,
+          hasActiveVisual: true,
+        ),
+        isFalse,
+      );
+    });
+
+    test('never forces fallback if videos are not filtered', () {
+      expect(
+        voiceGridNeedsAudioOnlyFallback(
+          onlyShowVideos: false,
+          hasActiveVisual: false,
+        ),
+        isFalse,
+      );
+    });
+  });
+}
