+// The message evaluator schedules playback asynchronously. Wait for the
+// observable sound instead of racing a fixed-duration sleep under CI load.
+Future<void> _waitForSfx(_RecordingSfx sfx) async {
+  final DateTime deadline = DateTime.now().add(const Duration(seconds: 3));
+  while (sfx.played.isEmpty && DateTime.now().isBefore(deadline)) {
+    await Future<void>.delayed(const Duration(milliseconds: 25));
+  }
+}
